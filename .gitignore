# Vendor repos cloned from upstream — managed independently with their own git
.claude/vendor/

# Gstack lives in .claude/skills/gstack/ per its setup convention (large, separate git)
.claude/skills/gstack/

# Regenerated by .claude/bin/setup-symlinks.sh + gstack ./setup
# (symlinks would be broken on a fresh clone without vendor/ and skills/gstack/)
.claude/skills/*
!.claude/skills/.gitkeep
.claude/agents/*
!.claude/agents/.gitkeep
.claude/commands/*
!.claude/commands/.gitkeep
.claude/hooks/*
!.claude/hooks/.gitkeep

# Local Claude settings (per-developer)
.claude/settings.local.json

# Node / Bun
node_modules/
bun.lockb

# Playwright artifacts (regenerated on every test run)
test-results/
playwright-report/
blob-report/
.playwright/

# Pipeline intermediate artifacts (regenerated by collect.js / score.js)
data/raw-collection.json
data/scored-items.json

# OS
.DS_Store
Thumbs.db
